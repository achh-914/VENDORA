# Gemini (default provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Anthropic (optional, set VENDORA_PROVIDER=claude to use it)
ANTHROPIC_API_KEY=
# Models (small model for extraction, stronger model for investigation)
EXTRACTION_MODEL=claude-haiku-5-5
REASONING_MODEL=claude-sonnet-5-5

# PostgreSQL
POSTGRES_USER=vendora
POSTGRES_PASSWORD=
POSTGRES_DB=vendora
# DATABASE_URL=postgresql://vendora:<password>@localhost:5432/vendora

# Embeddings (must match vector(1024) in db/migrations/001_init.sql)
EMBEDDING_DIM=1024

# Oracle Cloud Object Storage (needed at deployment)
OCI_NAMESPACE=
OCI_BUCKET=
OCI_REGION=
